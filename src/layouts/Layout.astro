---
// CSS
import '@/styles/global.css'

// Third-Party components
import { SEO } from 'astro-seo'
import Analytics from '@vercel/analytics/astro'

// i18n
import { getLangFromUrl } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)

const seoTitle =
  lang === 'en'
    ? 'Raúl Catalinas - Junior Mobile Developer'
    : 'Raúl Catalinas - Desarrollador Mobile Junior'

const seoDescription =
  lang === 'en'
    ? 'Junior Mobile Developer specializing in Flutter and Kotlin. Building cross-platform and native Android applications with focus on clean code.'
    : 'Desarrollador Mobile Junior especializado en Flutter y Kotlin. Construyendo aplicaciones multiplataforma y nativas para Android con enfoque en código limpio.'
---

<!doctype html>
<html {lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <SEO
      title={seoTitle}
      description={seoDescription}
      canonical={Astro.url.href}
      openGraph={{
        basic: {
          title: seoTitle,
          type: 'website',
          image: `${Astro.url.origin}/og-image.png`,
          url: Astro.url.href
        },
        optional: {
          description: seoDescription,
          locale: lang,
          siteName: 'Raúl Catalinas Portfolio'
        }
      }}
      twitter={{
        card: 'summary_large_image',
        site: '@CatalinasRaul',
        creator: '@CatalinasRaul'
      }}
      extend={{
        meta: [
          {
            name: 'keywords',
            content:
              'Flutter, Kotlin, Mobile Developer, Android, Portfolio, Junior Developer, Cross-platform'
          },
          { name: 'author', content: 'Raúl Catalinas' },
          { name: 'robots', content: 'index, follow' }
        ],
        link: [
          { rel: 'alternate', hreflang: 'en', href: `${Astro.url.origin}/` },
          { rel: 'alternate', hreflang: 'es', href: `${Astro.url.origin}/es` }
        ]
      }}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Raul Catalinas Esteban - Developer Portfolio</title>
    <link
      rel="preload"
      href="/fonts/Inter-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Inter-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Inter-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Analytics />

    <script is:inline>
      const theme = localStorage.getItem('theme') || 'light'

      const html = document.documentElement

      if (theme === 'dark') html.classList.add('dark')

      window.toggleTheme = () => {
        html.classList.toggle('dark')

        localStorage.setItem(
          'theme',
          html.classList.contains('dark') ? 'dark' : 'light'
        )
      }
    </script>
  </head>
  <body
    class="bg-white dark:bg-neutral-900 text-black dark:text-white transition-colors"
    id="top"
  >
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
  }

  h1,
  h2 {
    font-weight: 600;
  }

  h3,
  h4,
  h5,
  h6 {
    font-weight: 500;
  }

  strong,
  b {
    font-weight: 600;
  }
</style>
