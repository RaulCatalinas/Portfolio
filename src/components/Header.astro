---
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-neutral-300/90 dark:bg-neutral-800/90 backdrop-blur-md border-b border-neutral-400/20 dark:border-neutral-700/20"
>
  <nav class="flex justify-center items-center px-6 py-4">
    <ul class="flex gap-6 list-none">
      <li>
        <a
          href="#top"
          class="text-black dark:text-white hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
        >
          {t('nav.home')}
        </a>
      </li>
      <li>
        <a
          href="#about"
          class="text-black dark:text-white hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
        >
          {t('nav.about')}
        </a>
      </li>
      <li>
        <a
          href="#projects"
          class="text-black dark:text-white hover:text-blue-700 dark:hover:text-blue-400 transition-colors"
        >
          {t('nav.projects')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<div class="h-20"></div>
