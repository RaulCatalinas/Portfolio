---
// Types
import type { SocialNetwork } from '@/types/social-network'

// Astro
import { Image } from 'astro:assets'

interface Props {
  socialNetworks: SocialNetwork[]
}

const { socialNetworks } = Astro.props
---

<footer
  class="flex flex-row items-center justify-center bg-neutral-300 dark:bg-neutral-800 py-6"
>
  {
    socialNetworks.map(({ url, iconPath, iconAltText, invertColors, type }) => {
      const isTwitter = iconPath.includes('twitter')
      const size = isTwitter ? 30 : 26

      return (
        <a
          href={url}
          target={type === 'email' ? undefined : '_blank'}
          rel={type === 'email' ? undefined : 'noopener noreferrer'}
          class="mx-4 inline-block transition-transform hover:scale-110"
        >
          <Image
            src={iconPath}
            alt={iconAltText}
            width={size}
            height={size}
            decoding="async"
            loading="lazy"
            class={invertColors ? 'invert-0 dark:invert' : ''}
          />
        </a>
      )
    })
  }
</footer>
