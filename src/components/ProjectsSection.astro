---
// Components
import SectionLayout from '@/layouts/SectionLayout.astro'
import LinkAsButton from './LinkAsButton.astro'

// Types
import type { AppProject, LibraryProject, Project } from '@/types/projects'

// Astro
import { Image } from 'astro:assets'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

<SectionLayout title="Featured projects">
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-6 text-white max-w-5xl mx-auto"
  >
    {
      projects.map(project => {
        const packageUrl =
          project.type === 'library'
            ? (project as LibraryProject).packageUrl
            : undefined

        const imageUrl =
          project.type === 'app' ? (project as AppProject).imageUrl : undefined

        const altText =
          project.type === 'app' ? (project as AppProject).altText : undefined

        return (
          <article
            class={`flex flex-col items-center text-center bg-neutral-800 rounded-xl ${imageUrl ? 'p-8' : 'p-6 h-64'}`}
          >
            <span class="text-xs font-semibold text-blue-400 mb-4 uppercase tracking-widest">
              {`${project.type}${project.programmingLanguage ? ` • ${project.programmingLanguage}` : ''}`}
            </span>

            {imageUrl && altText && (
              <Image
                src={imageUrl}
                alt={altText}
                width={125}
                height={125}
                loading="lazy"
                class="mb-6"
              />
            )}

            <h3 class="text-2xl font-semibold mb-3">{project.title}</h3>

            <p
              class={`text-gray-400 mb-6 leading-relaxed text-pretty max-w-md ${imageUrl ? 'grow' : ''}`}
            >
              {project.description}
            </p>

            <div class="flex gap-3">
              <LinkAsButton
                href={project.codeUrl}
                text="View code"
                type="primary"
              />
              {packageUrl && (
                <LinkAsButton
                  href={packageUrl}
                  text="Package"
                  type="secondary"
                />
              )}
            </div>
          </article>
        )
      })
    }
  </div>
</SectionLayout>
