---
// Components
import SectionLayout from '@/layouts/SectionLayout.astro'
import LinkAsButton from './LinkAsButton.astro'
import LinkAsButtonWithIcon from './LinkAsButtonWithIcon.astro'
import RenderDevelopmentStatus from './RenderDevelopmentStatus.astro'
import RenderTechnologiesLabels from './RenderTechnologiesLabels.astro'

// Types
import type { AppProject, LibraryProject, Project } from '@/types/projects'

// Astro
import { Image } from 'astro:assets'

// i18n
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<SectionLayout title={t('featureProjects.sectionTitle')}>
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-6 text-black dark:text-white max-w-5xl mx-auto transition-colors"
  >
    {
      projects.map(project => {
        const packageUrl =
          project.type === 'library'
            ? (project as LibraryProject).packageUrl
            : undefined

        const programmingLanguage =
          project.type === 'library'
            ? (project as LibraryProject).programmingLanguage
            : undefined

        const imageUrl =
          project.type === 'app' ? (project as AppProject).imageUrl : undefined

        const altText =
          project.type === 'app' ? (project as AppProject).altText : undefined

        const technologies =
          project.type === 'app'
            ? (project as AppProject).technologies
            : undefined

        return (
          <article
            class={`
              flex flex-col items-center text-center bg-neutral-300 transition-colors
              dark:bg-neutral-800 rounded-xl ${imageUrl ? 'p-8' : 'p-6 h-70'}
            `}
          >
            <span class="text-xs font-medium text-blue-700 dark:text-blue-400/80 mb-4 uppercase tracking-widest transition-colors">
              {`
                ${project.type}${
                  programmingLanguage ? ` • ${programmingLanguage}` : ''
                }
              `}
            </span>

            {imageUrl && altText && (
              <Image
                src={imageUrl}
                alt={altText}
                width={125}
                height={125}
                loading="lazy"
                class="mb-6"
                decoding="async"
              />
            )}

            <div class="flex flex-row items-center justify-center gap-6 mb-3">
              <h3 class="text-2xl font-semibold">{project.title}</h3>
              <RenderDevelopmentStatus inDevelopment={project.inDevelopment} />
            </div>

            <p
              class={`text-neutral-800 dark:text-gray-400 mb-6 leading-loose transition-colors text-pretty max-w-md whitespace-pre-line ${imageUrl ? 'grow' : ''}`}
            >
              {project.description[lang]}
            </p>

            {technologies && (
              <RenderTechnologiesLabels
                technologies={technologies}
                type="secondary"
                styles="mb-6"
              />
            )}

            <div class="flex gap-4">
              <LinkAsButtonWithIcon
                href={project.codeUrl}
                text={t('featureProjects.viewCode')}
                type="primary"
                imageUrl="/icons/github.svg"
                altText="GitHub logo"
                imageWidth={30}
                imageHeight={30}
                imageLoading="lazy"
                styles="gap-4"
              />
              {packageUrl && (
                <LinkAsButton
                  href={packageUrl}
                  text={t('featureProjects.viewPackage')}
                  type="secondary"
                />
              )}
            </div>
          </article>
        )
      })
    }
  </div>
</SectionLayout>
