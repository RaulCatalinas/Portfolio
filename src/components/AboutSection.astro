---
// Components
import SectionLayout from '@/layouts/SectionLayout.astro'
import RenderTechnologiesLabels from './RenderTechnologiesLabels.astro'

// i18n
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

interface Props {
  technicalSkills: string[]
}

const { technicalSkills } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<SectionLayout title={t('about.sectionTitle')} id="about">
  <p class="text-black dark:text-white text-center mb-4 transition-colors">
    {t('about.intro')}
  </p>

  <div
    class="grid grid-cols-2 gap-6 text-center bg-neutral-300 dark:bg-neutral-800 p-6 rounded-xl transition-colors"
  >
    <div>
      <h3 class="text-black dark:text-white text-xl font-semibold mb-4">
        {t('about.sectionTitle')}
      </h3>
      <p
        class="text-black dark:text-white text-pretty mb-6 transition-colors leading-relaxed"
      >
        {t('about.descriptionPart1')}
      </p>
      <p
        class="text-black dark:text-white text-pretty transition-colors lea ding-relaxed"
      >
        {t('about.descriptionPart2')}
      </p>
    </div>
    <div>
      <h3
        class="text-black dark:text-white text-xl font-semibold mb-4 transition-colors"
      >
        {t('about.technicalSkills')}
      </h3>

      <RenderTechnologiesLabels technologies={technicalSkills} type="primary" />
    </div>
  </div>
</SectionLayout>
