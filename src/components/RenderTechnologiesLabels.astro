---
interface Props {
  technologies: string[]
  type: 'primary' | 'secondary'
  styles?: string
}

const { technologies, type, styles } = Astro.props
---

<div class={`flex flex-wrap gap-3 justify-center ${styles ?? ''}`}>
  {
    technologies.map(technology => (
      <span
        class={`
          bg-white dark:bg-neutral-700 px-4 py-2 rounded-full text-sm transition-colors
          ${type === 'primary' ? 'text-blue-700 dark:text-blue-400' : 'text-neutral-800 dark:text-white'}
        `}
      >
        {technology}
      </span>
    ))
  }
</div>
