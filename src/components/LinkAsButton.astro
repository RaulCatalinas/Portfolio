---
interface Props {
  href: string
  text: string
  type: 'primary' | 'secondary'
  styles?: string
}

const { href, text, type, styles } = Astro.props
---

<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  class={`
    inline-block px-5 py-2.5 rounded-md transition-colors font-medium
    ${
      type === 'primary'
        ? 'text-white bg-blue-600 hover:bg-blue-700'
        : `
          border text-neutral-800 dark:text-white bg-neutral-300
          hover:bg-neutral-400 border-neutral-400 hover:border-neutral-500
          dark:bg-neutral-800 dark:hover:bg-neutral-700 dark:border-neutral-700
          dark:hover:border-neutral-600
        `
    }
  `}
>
  <div class={`flex flex-row items-center justify-center ${styles ?? ''}`}>
    {text}

    <slot />
  </div>
</a>
