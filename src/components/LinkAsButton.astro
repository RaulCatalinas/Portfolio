---
interface Props {
  href: string
  text: string
  type: 'primary' | 'secondary'
}

const { href, text, type } = Astro.props
---

<a
  {href}
  target="_blank"
  rel="noopener noreferrer"
  class=`inline-block ${type === "primary" ? "bg-blue-600 hover:bg-blue-700" : "bg-neutral-800 hover:bg-neutral-700 border border-neutral-700 hover:border-neutral-600"} text-white px-5 py-2.5 rounded-md transition-colors font-medium`
>
  {text}
</a>
