---
// Components
import SectionLayout from '@/layouts/SectionLayout.astro'
import LinkAsButton from './LinkAsButton.astro'
import LinkAsButtonWithIcon from './LinkAsButtonWithIcon.astro'

// Constants
import { GITHUB_URL } from '@/constants/github'

// i18n
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<SectionLayout id="hero" styles="flex items-center justify-center">
  <div class="max-w-3xl text-center">
    <h3
      class="text-2xl font-semibold text-blue-700 dark:text-blue-400 mb-4 transition-colors"
    >
      {t('hero.greeting')}
    </h3>
    <h1
      class="text-6xl font-bold text-black dark:text-white mb-4 text-wrap transition-colors"
    >
      {t('hero.title')}
    </h1>

    <p
      class="text-xl text-dark dark:text-white mb-8 transition-colors text-pretty whitespace-pre-line leading-relaxed"
    >
      {t('hero.description')}
    </p>

    <div class="flex gap-4 justify-center">
      <LinkAsButton
        href="#projects"
        type="primary"
        text={t('hero.viewProjects')}
        openInNewTab={false}
      />

      <LinkAsButtonWithIcon
        href={GITHUB_URL}
        imageUrl="/icons/github.svg"
        altText="GitHub Icon"
        imageWidth={22}
        imageHeight={22}
        imageLoading="eager"
        text="GitHub"
        type="secondary"
        iconStyles="invert-0 dark:invert ml-3"
      />
    </div>
  </div>
</SectionLayout>
