---
// Components
import SectionLayout from '@/layouts/SectionLayout.astro'
import LinkAsButton from '../links/LinkAsButton.astro'
import LinkAsButtonWithIcon from '../links/LinkAsButtonWithIcon.astro'

// Constants
import { GITHUB_URL } from '@/constants/github'

// i18n
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<SectionLayout id="hero" styles="flex items-center justify-center">
  <div class="max-w-3xl text-center">
    <p
      class="text-sm font-medium text-blue-700 dark:text-blue-400 uppercase tracking-wider mb-4 transition-colors"
    >
      {t('hero.greeting')}
    </p>

    <h1
      class="text-5xl md:text-6xl font-bold text-black dark:text-white mb-6 transition-colors"
    >
      {t('hero.title')}
    </h1>

    <p
      class="text-xl text-gray-800 dark:text-gray-300 mb-8 transition-colors leading-relaxed max-w-2xl mx-auto whitespace-pre-line"
    >
      {t('hero.description')}
    </p>

    <div
      class="flex flex-col sm:flex-row gap-3 sm:gap-4 w-full sm:w-auto px-4 sm:px-0 md:items-center md:justify-center"
    >
      <LinkAsButton
        href="#projects"
        type="primary"
        text={t('hero.viewProjects')}
        openInNewTab={false}
        styles="w-full sm:w-auto"
      />

      <LinkAsButtonWithIcon
        href={GITHUB_URL}
        imageUrl="/icons/github.svg"
        altText="GitHub Icon"
        imageWidth={22}
        imageHeight={22}
        imageLoading="eager"
        text="GitHub"
        type="secondary"
        styles="gap-2 w-full sm:w-auto justify-center"
        iconStyles="invert-0 dark:invert "
        styles="gap-2"
      />
    </div>
  </div>
</SectionLayout>
