---
// Components
import SectionLayout from '@/layouts/SectionLayout.astro'
import AppCard from '../cards/AppCard.astro'

// Types
import type { AppProject, LibraryProject, Project } from '@/types/projects'

// i18n
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

interface Props {
  projects: Project[]
}

const { projects } = Astro.props

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<SectionLayout title={t('featureProjects.sectionTitle')} id="projects">
  <div
    class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 text-black dark:text-white max-w-5xl mx-auto transition-colors"
  >
    {
      projects.map(project => {
        const packageUrl =
          project.type === 'library'
            ? (project as LibraryProject).packageUrl
            : undefined

        const programmingLanguage =
          project.type === 'library'
            ? (project as LibraryProject).programmingLanguage
            : undefined

        const imageUrl =
          project.type === 'app' ? (project as AppProject).imageUrl : undefined

        const altText =
          project.type === 'app' ? (project as AppProject).altText : undefined

        const technologies =
          project.type === 'app'
            ? (project as AppProject).technologies
            : undefined

        const osIcons =
          project.type === 'app' ? (project as AppProject).osIcons : undefined

        const githubRepoName =
          project.type === 'app'
            ? (project as AppProject).githubRepoName
            : undefined

        return (
          <AppCard
            title={project.title}
            descriptions={project.descriptions}
            inDevelopment={project.inDevelopment}
            codeUrl={project.codeUrl}
            type={project.type}
            {programmingLanguage}
            {imageUrl}
            {altText}
            {technologies}
            {packageUrl}
            {osIcons}
            {githubRepoName}
          />
        )
      })
    }
  </div>
</SectionLayout>
